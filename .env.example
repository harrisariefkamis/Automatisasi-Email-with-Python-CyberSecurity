# Salin ke `.env` bila konfigurasi environment mulai digunakan.
# File ini hanya template; aplikasi saat ini belum membaca variabel-variabel ini.
# Jangan pernah memasukkan kredensial asli ke Git.

APP_ENV=development
LOG_LEVEL=INFO

# Database belum terhubung di versi demo saat ini.
DATABASE_URL=sqlite:///./data/email_assistant.db

# Integrasi email belum diimplementasikan. Gunakan OAuth dan izin minimum
# bila koneksi email ditambahkan; jangan simpan kata sandi akun di sini.
EMAIL_PROVIDER=none
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Integrasi AI eksternal belum diimplementasikan. Jangan isi API key asli
# atau kirim email berisi data sensitif tanpa persetujuan yang jelas.
AI_PROVIDER=none
AI_API_KEY=

# Tindakan yang mengubah email harus tetap dinonaktifkan secara default.
ACTIONS_ENABLED=false
