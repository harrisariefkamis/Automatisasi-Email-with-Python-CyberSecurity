APP_ENV=development
LOG_LEVEL=INFO
MAX_EMAIL_CHARS=20000
PERSIST_EMAIL_BODY=false

# OAuth client credentials only. User tokens must be handled in encrypted server-side storage.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501/oauth/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# External AI stays optional and requires per-operation user consent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase anon key + authenticated user's JWT (RLS required). Never use service role in app.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required by Vercel text-triage API. Set as a Vercel secret, not in Git.
API_ACCESS_TOKEN=
ACTIONS_ENABLED=false
